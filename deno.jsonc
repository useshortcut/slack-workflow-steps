{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/main/cli/schemas/config-file.v1.json",
  "lock": false,
  "tasks": {
    // The tests check every request against Shortcut's live v4 OpenAPI
    // document. Set SHORTCUT_OPENAPI_FILE to a saved copy to run offline.
    "test": "deno fmt --check && deno lint && deno check && deno test --allow-read --allow-env=SHORTCUT_OPENAPI_FILE --allow-net=api.app.shortcut.com"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.15",
    "@std/testing": "jsr:@std/testing@^1.0.16",
    "ajv": "npm:ajv@8.17.1",
    "deno-slack-sdk/": "https://deno.land/x/deno_slack_sdk@2.15.1/",
    "deno-slack-api/": "https://deno.land/x/deno_slack_api@2.8.0/"
  }
}
